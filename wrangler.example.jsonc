{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claimaxis",
  "compatibility_date": "2026-08-02",
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claimaxis-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
